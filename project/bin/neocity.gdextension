[configuration]
entry_symbol = "neocity_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug = "res://bin/libneocity.dylib"
macos.release = "res://bin/libneocity.dylib"
linux.debug.x86_64 = "res://bin/libneocity.so"
linux.release.x86_64 = "res://bin/libneocity.so"
windows.debug.x86_64 = "res://bin/libneocity.dll"
windows.release.x86_64 = "res://bin/libneocity.dll"
